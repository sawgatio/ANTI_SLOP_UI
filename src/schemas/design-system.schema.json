{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anti-slop-ui.dev/schemas/design-system.schema.json",
  "title": "Anti-Slop Design System",
  "description": "A strict design-system contract injected into UI-generation prompts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "purpose", "colors", "typography", "spacing", "density", "components"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "colors": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/colorToken" },
      "minProperties": 1
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fontFamily", "scale"],
      "properties": {
        "fontFamily": { "type": "string", "minLength": 1 },
        "scale": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/typeToken" },
          "minProperties": 1
        }
      }
    },
    "spacing": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/spaceToken" },
      "minProperties": 1
    },
    "radii": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9]+(px|rem|%)$" }
    },
    "density": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxVisibleActions", "maxBadgesPerRow", "maxTextLinesInSummary", "maxInteractiveElementsPerRegion"],
      "properties": {
        "maxVisibleActions": { "type": "integer", "minimum": 1 },
        "maxBadgesPerRow": { "type": "integer", "minimum": 0 },
        "maxTextLinesInSummary": { "type": "integer", "minimum": 1 },
        "maxInteractiveElementsPerRegion": { "type": "integer", "minimum": 1 }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/componentContract" },
      "minProperties": 1
    }
  },
  "$defs": {
    "colorToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "purpose"],
      "properties": {
        "value": { "type": "string", "pattern": "^(#[0-9A-Fa-f]{6}|rgba?\\([^)]*\\)|var\\(--[a-z0-9-]+\\))$" },
        "purpose": { "type": "string", "minLength": 1 },
        "contrastAgainst": { "type": "string" }
      }
    },
    "typeToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fontSize", "lineHeight", "fontWeight"],
      "properties": {
        "fontSize": { "type": "string", "pattern": "^[0-9.]+(px|rem)$" },
        "lineHeight": { "type": "number", "exclusiveMinimum": 0 },
        "fontWeight": { "type": "integer", "minimum": 100, "maximum": 900 },
        "letterSpacing": { "type": "string" }
      }
    },
    "spaceToken": {
      "type": "string",
      "pattern": "^[0-9.]+(px|rem)$"
    },
    "componentContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedVariants", "requiredStates", "rules"],
      "properties": {
        "allowedVariants": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "requiredStates": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "rules": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}